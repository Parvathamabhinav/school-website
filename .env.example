# Canonical origin for this deployment (used for metadata, sitemap, robots).
# Required in production: without it, canonical links and the sitemap point
# at http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Enquiries from the Admissions and Contact forms (server only; never
# NEXT_PUBLIC_). A webhook that accepts a JSON POST: an automation service,
# CRM or form backend; the payload's "type" says which form sent it. Without
# it, the forms say plainly that nothing was sent.
ENQUIRY_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <secret>".
ENQUIRY_WEBHOOK_SECRET=
