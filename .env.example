# Canonical origin for this deployment (used for metadata, sitemap, robots).
# Required in production: without it, canonical links and the sitemap point
# at http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Enquiry delivery for the Admissions and Contact forms (server only; never
# NEXT_PUBLIC_). Intended receiver: an n8n workflow that emails the school and
# appends a Google Sheets row. Contract and setup: docs/enquiry-webhook.md.
# Not active until that workflow is built and tested; until then the forms say
# plainly that nothing was sent. Configure rate limiting before public launch.
#
# Required: the n8n production webhook URL (must be https:// in production).
ENQUIRY_WEBHOOK_URL=
# Required in production: a long random string (e.g. openssl rand -hex 32),
# sent as "Authorization: Bearer <secret>" and checked by n8n Header Auth.
ENQUIRY_WEBHOOK_SECRET=

# Optional: "true" exposes the internal /design-system page in production.
# ENABLE_DESIGN_SYSTEM=true
