# Canonical origin for this deployment (used for metadata, sitemap, robots).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Admissions enquiries (server only; never NEXT_PUBLIC_). A webhook that
# accepts a JSON POST: an automation service, CRM or form backend. Without
# it, the enquiry form says plainly that nothing was sent.
ENQUIRY_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <secret>".
ENQUIRY_WEBHOOK_SECRET=
